{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Ecosystem Project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$files = Get-ChildItem -Path src -Recurse -Filter *.java | % { $_.FullName }; javac -encoding UTF-8 -d bin -cp bin $files"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Run Ecosystem Simulation",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/run.ps1"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Ecosystem Project",
            "problemMatcher": []
        }
    ]
}
